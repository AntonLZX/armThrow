<?xml version="1.0"?>
<robot name="3dof_thrower">

  <link name="base_link">
    <visual>
      <geometry><cylinder length="0.1" radius="0.2"/></geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.05"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="10" lower="-3.14" upper="3.14"/>
  </joint>

  <link name="link_1">
    <visual>
      <origin xyz="0 0 0.25"/>
      <geometry><capsule length="0.5" radius="0.05"/></geometry>
    </visual>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.5"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="10" lower="-1.57" upper="1.57"/>
  </joint>

  <link name="link_2">
    <visual>
      <origin xyz="0 0 0.25"/>
      <geometry><capsule length="0.5" radius="0.04"/></geometry>
    </visual>
  </link>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="cup_link"/>
    <origin xyz="0 0 0.5"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="10" lower="-1.57" upper="1.57"/>
  </joint>

  <link name="cup_link">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.1 0.1 0.1"/></geometry>
      <material name="blue"><color rgba="0 0 0.8 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.1 0.1 0.1"/></geometry>
    </collision>
  </link>

</robot>